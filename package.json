{
  "name": "trafficsim2",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "preprocess": "NODE_OPTIONS='--max-old-space-size=4096' tsx scripts/preprocess-osm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cbor-x": "^1.6.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^26.1.1",
    "@types/sax": "^1.2.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "sax": "^1.4.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  }
}
